# === App ===
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change-this-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === Database ===
DATABASE_URL=postgresql+asyncpg://ezidatic:ezidatic@localhost:5432/ezidatic

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Storage ===
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads
MAX_FILE_SIZE_MB=50

# === LLM Providers (priority order) ===
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# OpenRouter free models rotate fast; the picked one is whatever responds
# at session start. Update via probe script if 429s persist.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.5-air:free

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# === Vector Store ===
VECTOR_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma

# === CORS ===
CORS_ORIGINS=http://localhost:3000
